<!-- The three functions a board reads a message through.

     All three are the same script in three modes. `render_message_html` puts
     the text and its entities back together as HTML, the way a client draws it;
     `render_message_text` spells out only what the entities add that the text
     does not already say, for a panel that prints no markup; and
     `render_keyboard_html` draws the buttons underneath. See
     udf/render_message.py.

     `executable_pool` keeps a process alive between calls rather than starting
     python once per block, which is why the script flushes every row.

     `command` is looked up inside `user_scripts_path`, which is what
     `execute_direct` does, left at its default of 1, and the word after it is
     the mode. That path is /var/lib/clickhouse/user_scripts/, next to the data;
     this file is the only piece that goes into the config directory,
     /etc/clickhouse-server/, where the `*_function.xml` glob looks for it.

     Note for anyone editing the prose above: XML forbids a double hyphen inside
     a comment, and the server refuses the whole file over it (SAXParseException,
     "Invalid token"), which reads like a problem with the functions rather than
     with a dash. `python3 udf/test_render_message.py` parses this file for that
     reason. -->

<functions>
    <function>
        <type>executable_pool</type>
        <name>render_message_html</name>
        <return_type>String</return_type>
        <return_name>result</return_name>
        <argument>
            <type>String</type>
            <name>message</name>
        </argument>
        <argument>
            <type>Array(Tuple(type String, offset UInt32, length UInt32, payload String))</type>
            <name>entities</name>
        </argument>
        <format>JSONEachRow</format>
        <command>render_message.py html</command>
        <pool_size>4</pool_size>
        <command_read_timeout>10000</command_read_timeout>
        <command_write_timeout>10000</command_write_timeout>
    </function>
    <function>
        <type>executable_pool</type>
        <name>render_message_text</name>
        <return_type>String</return_type>
        <return_name>result</return_name>
        <argument>
            <type>String</type>
            <name>message</name>
        </argument>
        <argument>
            <type>Array(Tuple(type String, offset UInt32, length UInt32, payload String))</type>
            <name>entities</name>
        </argument>
        <format>JSONEachRow</format>
        <command>render_message.py text</command>
        <pool_size>4</pool_size>
        <command_read_timeout>10000</command_read_timeout>
        <command_write_timeout>10000</command_write_timeout>
    </function>
    <function>
        <type>executable_pool</type>
        <name>render_keyboard_html</name>
        <return_type>String</return_type>
        <return_name>result</return_name>
        <argument>
            <type>Array(Tuple(row UInt8, text String, type String, payload String))</type>
            <name>keyboard</name>
        </argument>
        <format>JSONEachRow</format>
        <command>render_message.py keyboard</command>
        <pool_size>4</pool_size>
        <command_read_timeout>10000</command_read_timeout>
        <command_write_timeout>10000</command_write_timeout>
    </function>
</functions>
