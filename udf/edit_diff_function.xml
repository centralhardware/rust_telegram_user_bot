<!-- The two functions `v_edit_log` reads an edit row through.

     Both are the same script in two modes: `html` renders the patch into the
     marked-up message a board prints, `prev` walks it back to the text the edit
     replaced. See udf/edit_diff.py.

     `executable_pool` keeps a process alive between calls rather than starting
     python once per block, which is why the script flushes every row.

     `command` is looked up inside `user_scripts_path` -- which is what
     `execute_direct` does, left at its default of 1 -- and the word after it is
     the mode. That path is
     /var/lib/clickhouse/user_scripts/ -- on the data volume, so the script
     survives a container recreation the way the data does. This file is the
     only piece that has to go into the config directory. -->
<functions>
    <function>
        <type>executable_pool</type>
        <name>edit_diff_html</name>
        <return_type>String</return_type>
        <return_name>result</return_name>
        <argument>
            <type>String</type>
            <name>message</name>
        </argument>
        <argument>
            <type>String</type>
            <name>patch</name>
        </argument>
        <format>JSONEachRow</format>
        <command>edit_diff.py html</command>
        <pool_size>4</pool_size>
        <command_read_timeout>10000</command_read_timeout>
        <command_write_timeout>10000</command_write_timeout>
    </function>
    <function>
        <type>executable_pool</type>
        <name>edit_prev_text</name>
        <return_type>String</return_type>
        <return_name>result</return_name>
        <argument>
            <type>String</type>
            <name>message</name>
        </argument>
        <argument>
            <type>String</type>
            <name>patch</name>
        </argument>
        <format>JSONEachRow</format>
        <command>edit_diff.py prev</command>
        <pool_size>4</pool_size>
        <command_read_timeout>10000</command_read_timeout>
        <command_write_timeout>10000</command_write_timeout>
    </function>
</functions>
